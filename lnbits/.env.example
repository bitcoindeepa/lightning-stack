# LNbits on Railway - copy these as Railway environment variables on the LNbits
# service. Do NOT commit real values. See DEPLOY.md for the full runbook.

# ---------------------------------------------------------------------------
# Funding source: our own LND node, over REST on Railway's private network.
# ---------------------------------------------------------------------------
LNBITS_BACKEND_WALLET_CLASS=LndRestWallet
LND_REST_ENDPOINT=https://lnd.railway.internal:8080

# The macaroon is passed as HEX (LNbits' load_macaroon accepts hex directly).
LND_REST_MACAROON=PASTE_ADMIN_MACAROON_HEX

# The certificate is NOT. LNbits hands LND_REST_CERT to httpx as `verify=`,
# which only accepts a bool, an SSLContext, or a PATH to a CA bundle. Cert
# CONTENT in that variable fails with "[Errno 36] File name too long" and
# LNbits silently falls back to VoidWallet.
#
# So do not set LND_REST_CERT yourself. Set the BASE64 cert here instead and
# lnbits/start.sh writes it to /app/lnd-tls.cert and points LND_REST_CERT there.
LND_CERT_BASE64=PASTE_TLS_CERT_BASE64

# ---------------------------------------------------------------------------
# Database: Railway Postgres.
# ---------------------------------------------------------------------------
# GOTCHA: LNbits hard-rejects any URL not starting with "postgres://", and
# Railway's ${{Postgres.DATABASE_URL}} starts with "postgresql://". So build the
# URL from the parts instead - paste the line below EXACTLY, references and all:
#
#   postgres://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.PGDATABASE}}
#
LNBITS_DATABASE_URL=postgres://user:password@host:5432/railway

# Extension files and uploads still land on disk. Mount a small Railway volume
# at /app/data so they survive redeploys.
LNBITS_DATA_FOLDER=/app/data

# ---------------------------------------------------------------------------
# Networking. The LNbits image reads LNBITS_HOST/LNBITS_PORT (not HOST/PORT).
# Bind :: and NOT 0.0.0.0 - Railway's network is IPv6-only, and 0.0.0.0 listens
# on IPv4 only, so Railway's edge cannot reach the app. :: also accepts IPv4.
# ---------------------------------------------------------------------------
LNBITS_HOST=::
LNBITS_PORT=5000
PORT=5000
FORWARDED_ALLOW_IPS=*
# Must match the custom domain, with the trailing slash. Used to build LNURLs
# and Lightning Address callbacks.
LNBITS_BASEURL=https://pay.bitcoindeepa.com/

# ---------------------------------------------------------------------------
# Auth / admin. AUTH_SECRET_KEY signs sessions - changing it logs everyone out.
# ---------------------------------------------------------------------------
AUTH_SECRET_KEY=GENERATE_64_HEX_CHARS
LNBITS_ADMIN_UI=true
# Leave SUPER_USER empty on first boot. LNbits prints the super user id in the
# logs; set it here afterwards so it survives a fresh container.
SUPER_USER=
# Lock down who can register. EMPTY MEANS ANYONE WITH THE URL CAN CREATE A
# WALLET ON YOUR NODE. Public instances are scanned within hours. Register
# yourself first, take the user id from the UI, then set both of these and
# redeploy. Comma-separated for multiple ids.
LNBITS_ALLOWED_USERS=
LNBITS_ADMIN_USERS=

# ---------------------------------------------------------------------------
# Branding + extensions
# ---------------------------------------------------------------------------
LNBITS_SITE_TITLE=BitcoinDeepa
LNBITS_SITE_TAGLINE=Lightning wallets and payments
# JSON list. lnurlp powers Lightning Addresses; tpos is the point-of-sale.
LNBITS_EXTENSIONS_DEFAULT_INSTALL=["lnurlp"]
