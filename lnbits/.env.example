# LNbits on Railway - deploy from the image: lnbits/lnbits:latest
# Add a Volume mounted at /app/data. Set these as Railway environment variables
# (copy this file's keys/values; do NOT commit real secrets).

# Connect to your own LND node over REST (simplest over Railway's private network).
LNBITS_BACKEND_WALLET_CLASS=LndRestWallet
LND_REST_ENDPOINT=https://lnd.railway.internal:8080
# From the LND credential dump (start.sh PRINT_CREDS=1):
#   LND_REST_CERT     = TLS CERT (hex)
#   LND_REST_MACAROON = ADMIN MACAROON (hex)
LND_REST_CERT=PASTE_TLS_CERT_HEX
LND_REST_MACAROON=PASTE_ADMIN_MACAROON_HEX

# LNbits data (wallets, keys, balances) - keep on the volume so it survives restarts.
LNBITS_DATA_FOLDER=/app/data

# Networking. Railway provides $PORT and routes the public domain to it, so let
# LNbits listen on that. Do not hardcode PORT unless Railway needs it.
HOST=0.0.0.0
FORWARDED_ALLOW_IPS=*

# Optional niceties
LNBITS_SITE_TITLE=My LNbits
